# =============================================================================
# GODOT 4
# =============================================================================

# the editor's own cache: imported textures, shader cache, editor layout.
# regenerated on open, and machine-specific — never commit it.
.godot/

.nomedia

# FIXED: this line used to read `.import/	export.cfg` — two patterns
# separated by a tab. git reads a line as ONE pattern, so it was matching a
# path literally called ".import/<tab>export.cfg" and neither entry did
# anything. Split apart below.
#
# NOTE the trailing slash on `.import/`: that restricts the match to a
# DIRECTORY of that name (a Godot 3 leftover). It must never become
# `*.import`, which would exclude the per-asset .import files Godot 4
# generates — those are required metadata and DO belong in the repo.
.import/

export.cfg
export_credentials.cfg
*.tmp


# =============================================================================
# MONO / C#
# =============================================================================

.mono/

# CAREFUL: this is `data_*` with an underscore, so it does NOT match this
# project's own data/ folder (items, pets). Do not "tidy" it to `data*/` —
# that would silently stop tracking every item definition in the game.
data_*/

mono_crash.*.json


# =============================================================================
# BUILD OUTPUT AND SCRATCH  (added)
# =============================================================================

# exported builds — large, regenerable, and they change on every export.
builds/

# working files from Claude sessions: debug renders, sprite-sheet contact
# strips, notes. Useful while working, not part of the game. Godot generates
# .import files for any image left in the project folder, which is why these
# were showing up as assets.
Claude outputs/

# a stray near-duplicate of project.godot. The hyphen matters — this pattern
# does NOT match project.godot itself.
project-*.godot


# =============================================================================
# OS CRUFT
# =============================================================================

.DS_Store
Thumbs.db
desktop.ini
