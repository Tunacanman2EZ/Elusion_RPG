[sub_resource type="GDScript" id="GDScript_iuafe"]
script/source = "# houseswap.gd — toggles between an interior cutaway view and an exterior
# view of a building based on whether the player is inside the trigger area.
# attached to an Area2D that overlaps the house bounds.
#
# scene setup:
# parent node holds three children:
#   - this Area2D (with this script)
#   - \"interior\" sibling — the cutaway/inside view (Sprite2D, TileMap, etc.)
#   - \"exterior\" sibling — the full outside view
#
# fallback name lookup:
# checks lowercase \"interior\" / \"exterior\" first (project convention),
# falls back to CamelCase \"Interior\" / \"Exterior\" for older scenes that
# predate the lowercase naming rule.
#
# starting state:
# player begins outside the building, so exterior visible / interior hidden.
# entering the trigger flips both — exiting flips them back.
extends Area2D


# =============================================================================
# STATE
# =============================================================================

# sibling node references — resolved in _ready() with name fallback.
# stored as Node (not specific type) since they could be Sprite2D, TileMap,
# Node2D containers with their own children, etc.
var interior: Node = null
var exterior: Node = null


# =============================================================================
# LIFECYCLE
# =============================================================================

func _ready() -> void:
	_find_sibling_nodes()
	_set_initial_visibility()
	_wire_collision_signals()
	_warn_about_missing_siblings()


# =============================================================================
# INITIALIZATION HELPERS
# =============================================================================

func _find_sibling_nodes() -> void:
	# search the parent for interior/exterior nodes.
	# tries lowercase first (project convention), then CamelCase for
	# backward compatibility with older scenes.
	var parent: Node = get_parent()
	if parent == null:
		return

	interior = _find_node_with_fallback(parent, \"interior\", \"Interior\")
	exterior = _find_node_with_fallback(parent, \"exterior\", \"Exterior\")


func _find_node_with_fallback(parent: Node, primary: String, fallback: String) -> Node:
	# returns the first matching child name, or null if neither exists.
	# extracted so the lookup pattern is consistent for both siblings.
	if parent.has_node(primary):
		return parent.get_node(primary)
	if parent.has_node(fallback):
		return parent.get_node(fallback)
	return null


func _set_initial_visibility() -> void:
	# starting state — exterior visible, interior hidden.
	# the player starts outside the building so only the outer view shows.
	if interior != null:
		interior.visible = false
	if exterior != null:
		exterior.visible = true


func _wire_collision_signals() -> void:
	# connect both signals — guarded against double-connection in case
	# they're also wired through the editor's Signals panel.
	# without these connects, the signal handlers never fire and the
	# swap doesn't happen.
	if not body_entered.is_connected(_on_body_entered):
		body_entered.connect(_on_body_entered)
	if not body_exited.is_connected(_on_body_exited):
		body_exited.connect(_on_body_exited)


func _warn_about_missing_siblings() -> void:
	# log loudly if the expected sibling nodes weren't found.
	# easier to catch setup mistakes at runtime than silently failing.
	if interior == null:
		push_warning(\"HouseSwap: 'interior' node not found as sibling\")
	if exterior == null:
		push_warning(\"HouseSwap: 'exterior' node not found as sibling\")


# =============================================================================
# COLLISION HANDLERS
# =============================================================================

func _on_body_entered(body: Node2D) -> void:
	# fired when any body enters the trigger area. only respond to the player.
	#
	# NOTE: the player's body must be on a collision layer that this Area2D's
	# mask includes — if it isn't, this signal never fires. check both layer
	# and mask in the Inspector if entering the trigger does nothing.
	if not body.is_in_group(\"player\"):
		return
	print(\"HouseSwap: player entered, showing interior\")
	_swap_to_interior()


func _on_body_exited(body: Node2D) -> void:
	# fired when the player leaves the area — swap back to exterior view
	if not body.is_in_group(\"player\"):
		return
	print(\"HouseSwap: player left, showing exterior\")
	_swap_to_exterior()


# =============================================================================
# VIEW SWAPS
# =============================================================================

func _swap_to_interior() -> void:
	# show interior, hide exterior. both null-guarded so a missing sibling
	# doesn't crash the swap — the other side still toggles correctly.
	if interior != null:
		interior.visible = true
	if exterior != null:
		exterior.visible = false


func _swap_to_exterior() -> void:
	# show exterior, hide interior. mirror of _swap_to_interior.
	if interior != null:
		interior.visible = false
	if exterior != null:
		exterior.visible = true
"

