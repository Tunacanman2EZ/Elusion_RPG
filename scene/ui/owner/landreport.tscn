[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/owner/landreport.gd" id="1_report"]
[ext_resource type="Theme" path="res://assets/themes/staff_ui_theme.tres" id="2_stafftheme"]
[ext_resource type="Script" path="res://src/ui/owner/hourschart.gd" id="3_hours"]

[node name="landreport" type="Control"]
theme = ExtResource("2_stafftheme")
layout_mode = 3
offset_left = 320.0
offset_top = 40.0
offset_right = 980.0
offset_bottom = 636.0
mouse_filter = 2
script = ExtResource("1_report")

[node name="frame" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="margin" type="MarginContainer" parent="frame"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="rows" type="VBoxContainer" parent="frame/margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="headerpanel" type="PanelContainer" parent="frame/margin/rows"]
layout_mode = 2
theme_type_variation = &"PanelHeader"

[node name="headerbox" type="HBoxContainer" parent="frame/margin/rows/headerpanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="title" type="Label" parent="frame/margin/rows/headerpanel/headerbox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.92941, 0.72941, 0.30196, 1)
theme_override_font_sizes/font_size = 18
text = "LANDS"
vertical_alignment = 1

[node name="hint" type="Label" parent="frame/margin/rows/headerpanel/headerbox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45098, 0.50196, 0.57647, 1)
theme_override_font_sizes/font_size = 11
text = "owner only - counts, never names"
vertical_alignment = 1

[node name="landreportclose" type="Button" parent="frame/margin/rows/headerpanel/headerbox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(28, 26)
layout_mode = 2
tooltip_text = "Close  (Esc)"
focus_mode = 0
theme_override_font_sizes/font_size = 13
text = "×"

[node name="toprow" type="HBoxContainer" parent="frame/margin/rows"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="landreportrefresh" type="Button" parent="frame/margin/rows/toprow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Read the lands again from the server"
focus_mode = 0
theme_override_font_sizes/font_size = 13
text = "Refresh"

[node name="toplabel" type="Label" parent="frame/margin/rows/toprow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.78, 0.84, 1)
theme_override_font_sizes/font_size = 12
text = "The next stir and why, every land this week, and when players are on."
vertical_alignment = 1

[node name="listbox" type="PanelContainer" parent="frame/margin/rows"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"PanelSub"

[node name="listmargin" type="MarginContainer" parent="frame/margin/rows/listbox"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="landreportbox" type="RichTextLabel" parent="frame/margin/rows/listbox/listmargin"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 250)
layout_mode = 2
size_flags_vertical = 3
focus_mode = 2
theme_override_font_sizes/normal_font_size = 13
selection_enabled = true

[node name="landhourslabel" type="Label" parent="frame/margin/rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.78, 0.84, 1)
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "Players online by hour, your time."

[node name="landhours" type="Control" parent="frame/margin/rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
script = ExtResource("3_hours")

[node name="landreportstatus" type="Label" parent="frame/margin/rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.78, 0.84, 1)
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "Press Refresh."
