[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/owner/statswindow.gd" id="1_stats"]
[ext_resource type="Theme" path="res://assets/themes/staff_ui_theme.tres" id="2_stafftheme"]

[node name="statswindow" type="Control"]
theme = ExtResource("2_stafftheme")
layout_mode = 3
offset_left = 380.0
offset_top = 50.0
offset_right = 940.0
offset_bottom = 610.0
mouse_filter = 2
script = ExtResource("1_stats")

[node name="frame" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="margin" type="MarginContainer" parent="frame"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="rows" type="VBoxContainer" parent="frame/margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="headerpanel" type="PanelContainer" parent="frame/margin/rows"]
layout_mode = 2
theme_type_variation = &"PanelHeader"

[node name="headerbox" type="HBoxContainer" parent="frame/margin/rows/headerpanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="title" type="Label" parent="frame/margin/rows/headerpanel/headerbox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.92941, 0.72941, 0.30196, 1)
theme_override_font_sizes/font_size = 18
text = "PLAYER STATS"
vertical_alignment = 1

[node name="hint" type="Label" parent="frame/margin/rows/headerpanel/headerbox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45098, 0.50196, 0.57647, 1)
theme_override_font_sizes/font_size = 11
text = "owner only - players, not staff"
vertical_alignment = 1

[node name="statsclose" type="Button" parent="frame/margin/rows/headerpanel/headerbox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(28, 26)
layout_mode = 2
tooltip_text = "Close  (Esc)"
focus_mode = 0
theme_override_font_sizes/font_size = 13
text = "×"

[node name="toprow" type="HBoxContainer" parent="frame/margin/rows"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="statsrefresh" type="Button" parent="frame/margin/rows/toprow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Read the numbers again from the server"
focus_mode = 0
theme_override_font_sizes/font_size = 13
text = "Refresh"

[node name="dayslabel" type="Label" parent="frame/margin/rows/toprow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.78, 0.84, 1)
theme_override_font_sizes/font_size = 12
text = "New players from the last"
vertical_alignment = 1

[node name="statsdays" type="OptionButton" parent="frame/margin/rows/toprow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
tooltip_text = "How far back a player signed up to count as new"
focus_mode = 0
theme_override_font_sizes/font_size = 13

[node name="listbox" type="PanelContainer" parent="frame/margin/rows"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"PanelSub"

[node name="listmargin" type="MarginContainer" parent="frame/margin/rows/listbox"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="statsreport" type="RichTextLabel" parent="frame/margin/rows/listbox/listmargin"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 300)
layout_mode = 2
size_flags_vertical = 3
focus_mode = 2
theme_override_font_sizes/normal_font_size = 13
selection_enabled = true

[node name="statsstatus" type="Label" parent="frame/margin/rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.78, 0.84, 1)
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "Press Refresh."
